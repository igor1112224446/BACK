APP_ENV=development
DATABASE_URL=sqlite:///./colibri.db
TELEGRAM_BOT_TOKEN=
BOT_API_KEY=change-me
RESULTS_LIMIT=5
DEFAULT_HANDOFF_LOCATION=Точное место передачи уточнит оператор Colibri после подтверждения.
DEFAULT_PAYMENT_INSTRUCTIONS=Оплата производится в момент передачи посылки по реквизитам, которые направит Colibri.
DEFAULT_SENDER_SUCCESS_TEMPLATE=Мы нашли для вас подходящего попутчика для вашей посылки.\n\nМаршрут: {from_city} → {to_city}\nПередача: {handoff_time}\nМесто: {handoff_location}\nОплата: {payment_instructions}
DEFAULT_TRAVELER_SUCCESS_TEMPLATE=Мы нашли для вас подходящую посылку для вашей поездки.\n\nМаршрут: {from_city} → {to_city}\nПередача: {handoff_time}\nМесто: {handoff_location}\nОплата: {payment_instructions}
